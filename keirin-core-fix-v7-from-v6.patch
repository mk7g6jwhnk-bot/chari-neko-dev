+  if(!branch?.primaryLineId)return true;
+  const samePrimaryLine=participant.lineId===branch.primaryLineId;
+  switch(branch.branchType){
+    case"LEADER_HOLD":
+    case"MAKURI_SUCCESS":
+      return samePrimaryLine&&participant.role==="自力";
+    case"BANTE_SASHI":

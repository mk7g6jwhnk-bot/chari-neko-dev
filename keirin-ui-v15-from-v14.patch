+.timelineVenue small{color:var(--muted);font-size:.72rem}
+.battleToggle,.raceBattle{border:1px solid var(--line);background:var(--inset);color:#94a3b8;border-radius:12px;font-size:1.25rem;line-height:1}
+.battleToggle.active,.raceBattle.active{color:#facc15;border-color:#8a6d15;background:#332a0b}
+.raceCardWrap{position:relative;min-width:0}
+.raceCardWrap>.raceCard{width:100%;height:100%;padding-right:34px}
+.raceBattle{position:absolute;right:7px;bottom:7px;width:30px;height:30px;min-height:30px;padding:0;border-radius:9px;font-size:1rem}
+@media(max-width:520px){.meetingTools{grid-template-columns:1fr}.raceTab{font-size:.72rem;padding:6px 4px}.timelineRace{grid-template-columns:1fr 42px}}

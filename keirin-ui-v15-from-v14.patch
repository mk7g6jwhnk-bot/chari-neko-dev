+/* v15: today / battle / venues navigation */
+.raceTabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:0 0 12px}
+.raceTab{min-height:42px;border:1px solid var(--line);border-radius:11px;background:var(--inset);color:var(--muted);font-weight:800;font-size:.78rem}
+.raceTab.active{background:#0f5048;border-color:#2a8f84;color:#fff}

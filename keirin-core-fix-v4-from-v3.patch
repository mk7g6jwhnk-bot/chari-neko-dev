 :root{color-scheme:dark;--bg:#08111f;--card:#132039;--inset:#0a1425;--line:#2a3b58;--text:#f8fafc;--muted:#94a3b8;--accent:#5bc0b4;--warning:#f59e0b;--danger:#f87171}*{box-sizing:border-box}html,body{margin:0;min-width:320px;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input{font:inherit}button{min-height:44px;cursor:pointer}.hidden{display:none!important}.appHeader{position:sticky;top:0;z-index:20;height:calc(64px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 12px 0;display:grid;grid-template-columns:48px 1fr 48px;align-items:center;background:#08111ff2;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.brand,.iconBtn{border:0;background:transparent;color:var(--text)}.brand{display:flex;justify-content:center;align-items:center;gap:8px}.brand>span{display:grid;text-align:left}.brand strong{font-size:1.05rem}.brand small{color:var(--accent);font-size:.68rem}.brand>span:first-child{font-size:1.5rem}.iconBtn{font-size:1.4rem;border-radius:12px}.iconBtn:active{background:var(--card)}main{width:min(100%,760px);margin:auto;padding:16px 14px calc(92px + env(safe-area-inset-bottom))}.screen{display:none}.screen.active{display:block}.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px}.card.compact{padding:14px}.hero{background:linear-gradient(145deg,#17304b,#132039)}.hero small,.pageTitle small,.sectionHead small{color:var(--accent);font-weight:700;letter-spacing:.08em}.hero h1,.pageTitle h1{font-size:1.45rem;margin:6px 0}.hero p,.muted{color:var(--muted)}.primary,.secondary{width:100%;border-radius:12px;padding:12px 14px;font-weight:800}.primary{border:0;background:var(--accent);color:#05201c}.primary:disabled{opacity:.55;cursor:wait}.secondary{border:1px solid var(--line);background:#17243a;color:var(--text);margin-top:8px}.pageTitle,.sectionHead,.meetingTop,.raceTop{display:flex;justify-content:space-between;align-items
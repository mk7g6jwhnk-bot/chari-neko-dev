+function applyPurchaseValueOnly(items,oddsByOrder={}){
+  return items.map(item=>{
+    const key=(item.order||[]).join("-");
+    const odds=Number(oddsByOrder?.[key]);
+    const probability=Number(item.probability);
+    const value=Number.isFinite(odds)&&Number.isFinite(probability)
+      ? probability*odds
+      : null;
+    return {
+      ...item,
+      marketOdds:Number.isFinite(odds)?odds:null,
+      purchaseValue:value,
+      purchaseValueSource:value===null?"UNAVAILABLE":"PROBABILITY_X_MARKET_ODDS"
+    };
+  });
